#!/usr/bin/env bash
# Reinstall emacs-plus@32 from the latest CI-built nightly bottle.
#
# The bottle block in Formula/emacs-plus@32.rb (a fork-only addition) points
# at this fork's fixed "emacs-plus-32-nightly" release; its sha256 is updated
# by .github/workflows/build-bottle.yml on every build. A normal tapped
# install is used because Workbrew blocks installing bottles from local
# files/URLs.
set -euo pipefail

echo "Updating tap..."
brew update

echo "Reinstalling emacs-plus@32 from the nightly bottle..."
brew reinstall ryankask/emacs-plus/emacs-plus@32

echo "Verifying..."
"$(brew --prefix)/bin/emacs" --batch --eval='(print (emacs-version))'
